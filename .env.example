# Copy to .env and fill in real values. No database needed — data lives in data/clinic.json.
# Any OpenAI-compatible provider works; the defaults below are Google Gemini.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
AGENT_MAX_TOOL_ROUNDS=6
