# Copy to .env and fill in real values. No database needed — data lives in data/clinic.json.
# Any OpenAI-compatible provider works; the defaults below are Google Gemini.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
AGENT_MAX_TOOL_ROUNDS=6
# Optional: webhook URL (Telegram bot / Slack incoming hook / any JSON endpoint)
# that gets pinged when a customer is escalated to a human. Escalations are
# always appended to data/escalations.log regardless.
NOTIFY_WEBHOOK_URL=
# --- Voice (optional; see VOICE.md) ---
# LiveKit Cloud free tier: https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Speech-to-text for the voice channel: Deepgram (recommended, free credit,
# strong Hindi) or Groq (whisper-large-v3, free tier)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
